# =============================================================
# Financial RAG System Environment Variables
# =============================================================

# Paths
DATABASE_PATH=data/structured/financial.db
MANIFEST_PATH=data/manifest.csv
METRICS_SEED_PATH=data/structured/metrics_seed.csv
FAISS_INDEX_PATH=data/index/faiss.index
CHUNK_IDS_PATH=data/index/chunk_ids.json
EVAL_QUESTIONS_PATH=data/eval/questions.csv

# LLM Backend: "qwen_local" | "mock" | "openai"
LLM_BACKEND=qwen_local
LLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
LLM_DEVICE=cuda
LLM_FP16=true
LLM_MAX_NEW_TOKENS=512

# Embeddings: "bge-m3" | "sentence-transformers" | "mock"
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda

# Retrieval parameters
TOP_K_CHUNKS=4
DENSE_WEIGHT=0.6
FTS_WEIGHT=0.4
RELEVANCE_THRESHOLD=0.35

# UI
GRADIO_SHARE=false
GRADIO_SERVER_PORT=7860
