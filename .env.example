# ==============================================================================
# FINANCIAL MULTIMODAL RAG CONFIGURATION
# ==============================================================================

# LLM Provider Selection: "gemini" (default) or "llama" (OpenAI-compatible API)
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI CONFIGURATION (Active when LLM_PROVIDER=gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. LLAMA / OPENAI-COMPATIBLE API CONFIGURATION (Active when LLM_PROVIDER=llama)
# ------------------------------------------------------------------------------
# Popular API Endpoints:
# - Groq:        https://api.groq.com/openai/v1  (Model: llama-3.3-70b-versatile, llama-3.2-11b-vision-preview)
# - Together AI: https://api.together.xyz/v1     (Model: meta-llama/Llama-3.3-70B-Instruct-Turbo)
# - OpenRouter:  https://openrouter.ai/api/v1    (Model: meta-llama/llama-3.3-70b-instruct)
# - Ollama Local: http://localhost:11434/v1       (Model: llama3.2-vision:11b, llama3.3:70b)
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_API_KEY=gsk_your_groq_or_provider_api_key_here
LLAMA_CHAT_MODEL=llama-3.3-70b-versatile

# (Optional) Embedding model if your LLaMA API provider supports /v1/embeddings
# e.g., "togethercomputer/m2-bert-80M-8k-retrieval" or leave blank to use GEMINI_API_KEY for embeddings
# LLAMA_EMBEDDING_MODEL=

# ------------------------------------------------------------------------------
# 3. VECTOR STORE & STORAGE
# ------------------------------------------------------------------------------
APP_ENV=development
DATA_DIR=data
CHROMA_DIR=data/vectorstore
COLLECTION_NAME=financial_reports
