# The answering service never calls an LLM. No API key is needed.
# Legacy client settings below do not enable generation in /ask.
OPENAI_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
OCR_ENABLED=false
OCR_LANGUAGE=vie+eng
# Optional experiment. Tesseract remains the default; no model download during /ingest.
OCR_BACKEND=tesseract
OCR_FALLBACK_TO_TESSERACT=true
TABLE_BACKEND=none
# VIETOCR_WEIGHTS=C:/DXD/Multimodal-RAG-Financial/work/ocr-lab/models/vgg_seq2seq.pth
# OCR_DETECTOR_PATH=C:/DXD/Multimodal-RAG-Financial/work/ocr-lab/models/ch_PP-OCRv5_det_mobile.onnx
# TABLE_MODEL_PATH=C:/DXD/Multimodal-RAG-Financial/work/ocr-lab/models/slanet-plus.onnx
# TESSDATA_PREFIX=C:/path/to/tessdata
# TESSDATA_BEST_PREFIX=C:/path/to/tessdata-best

