# Hybrid architecture: Web UI & SQLite DB run locally; heavy GPU inference runs on Google Colab T4+.
# Leave COLAB_GPU_URL empty to run purely in offline local deterministic mode.
COLAB_GPU_URL=
COLAB_API_TOKEN=
COLAB_TIMEOUT=120
COLAB_OCR_ENABLED=false
COLAB_EMBEDDINGS_ENABLED=false

# Local Document Layout Analysis (table & chart regions)
# Options: none | heuristic | yolo
LAYOUT_BACKEND=none
# LAYOUT_MODEL_PATH=C:/RAG/data/models/layout_detector.onnx

# Local OCR settings
OCR_ENABLED=false
OCR_LANGUAGE=vie+eng
# Options: tesseract | vietocr | colab_gpu
OCR_BACKEND=tesseract
OCR_FALLBACK_TO_TESSERACT=true
# VIETOCR_WEIGHTS=C:/RAG/work/ocr-lab/models/vgg_seq2seq.pth
# OCR_DETECTOR_PATH=C:/RAG/work/ocr-lab/models/ch_PP-OCRv5_det_mobile.onnx
TABLE_BACKEND=none
# TABLE_MODEL_PATH=C:/RAG/work/ocr-lab/models/slanet-plus.onnx
# TESSDATA_PREFIX=C:/RAG/data/tessdata
# TESSDATA_BEST_PREFIX=C:/RAG/data/tessdata-best
